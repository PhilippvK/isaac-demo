ARG BASE_IMAGE=philippvk/isaac-quickstart-base
FROM ${BASE_IMAGE} AS builder
LABEL maintainer="ETISS Developers"

ARG CLONE_DEPTH=1
ENV PYTHONPATH=/work/M2-ISA-R

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates gnupg \
           build-essential cmake make python3 zlib1g wget subversion zip unzip git ninja-build python3-dev python3-pip python3-venv libssl-dev libboost-all-dev zip unzip && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir /work
COPY M2-ISA-R/ /work/M2-ISA-R

RUN python3 -m venv /work/venv
# Copied submodules do not include usable Git metadata for setuptools-scm.
ARG M2ISAR_VERSION=0.0.0
RUN . /work/venv/bin/activate && SETUPTOOLS_SCM_PRETEND_VERSION_FOR_M2ISAR=${M2ISAR_VERSION} python3 -m pip install /work/M2-ISA-R

COPY ./docker/etiss_script.sh /work/etiss_script.sh

ENTRYPOINT ["/work/etiss_script.sh"]
# TODO: replace
CMD ["help"]
