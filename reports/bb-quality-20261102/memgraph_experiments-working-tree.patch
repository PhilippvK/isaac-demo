+        paths = []
+        def visit(path):
+            if len(path) > 1:
+                paths.append(path)
+            if len(path) < 4:
+                for a, b in edges:
+                    if a == path[-1] and b not in path:
+                        visit(path + [b])
+        for n in range(4):
+            visit([n])
