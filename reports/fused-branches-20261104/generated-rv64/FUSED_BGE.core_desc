import "RVI.core_desc"

InstructionSet MySet extends RV64I {
    instructions {
        FUSED_BGE [[no_cont]] [[cond]] {
            operands: {
                unsigned<5> rs1 [[is_reg]] [[reg_class="GPR"]] [[reg_type="s64"]] [[in]];
                unsigned<5> rs2 [[is_reg]] [[reg_class="GPR"]] [[reg_type="s64"]] [[in]];
                signed<13> offset [[is_imm]] [[in]] [[is_branch_offs]];
            }
            encoding: auto;
            assembly: {"fused_bge", "{name(rs1)}, {name(rs2)}, {offset}"};
            behavior: {
                
                
                if ((signed<64>)((unsigned<64>)(((unsigned<64>)(unsigned<64>)(X[rs1])&(unsigned<64>)(unsigned<64>)(X[rs2]))))>=(signed<64>)((7))) { PC = PC + (signed<XLEN>)(offset); }
                
            }
        }
        

    }
}
