From 4d03f7f4eea738dac890cf6f17610ea81cff5e01 Mon Sep 17 00:00:00 2001
From: Philipp van Kempen <philipp.van-kempen@tum.de>
Date: Tue, 10 Nov 2026 06:33:33 +0100
Subject: [PATCH] Preserve unquantized file inputs in model validation

---
 mlonmcu/models/frontend.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/mlonmcu/models/frontend.py b/mlonmcu/models/frontend.py
index 17434ba1..9890b856 100644
--- a/mlonmcu/models/frontend.py
+++ b/mlonmcu/models/frontend.py
@@ -375,9 +375,9 @@ class Frontend(ABC):
                         assert input_name in input_shapes, f"Unknown shape for input: {input_name}"
                         shape = input_shapes[input_name]
                         arr = np.reshape(arr, shape)
-                        # Quantize if required
-                        # if gen_dtype != dtype:
-                        if True:
+                        # File inputs need quantization only when their stored
+                        # dtype differs from the quantized model input dtype.
+                        if quant and gen_dtype != dtype:
                             assert "int" in dtype
                             # assert quant
                             scale, shift, ty, qrng = quant
-- 
2.34.1

