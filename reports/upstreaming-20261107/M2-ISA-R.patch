From df47075858c770eb1391e73cdfd435183a40aecf Mon Sep 17 00:00:00 2001
From: Philipp van Kempen <philipp.van-kempen@tum.de>
Date: Fri, 6 Nov 2026 11:08:28 +0100
Subject: [PATCH 1/3] Handle intrinsic references without staticness attributes

---
 m2isar/metamodel/utils/scalar_staticness.py |  4 ++--
 tests/test_intrinsic_staticness.py          | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_intrinsic_staticness.py

diff --git a/m2isar/metamodel/utils/scalar_staticness.py b/m2isar/metamodel/utils/scalar_staticness.py
index c1d358c..48e2497 100644
--- a/m2isar/metamodel/utils/scalar_staticness.py
+++ b/m2isar/metamodel/utils/scalar_staticness.py
@@ -207,7 +207,7 @@ class VarAccessVisitor(ExprVisitor):
 	@generate.register
 	def _(self, expr: behav.Callable, context: attribute_info.AccessContext):
 		args = [self.generate(arg, context) for arg in expr.args]
-		is_static = bool(expr.ref_or_name.attributes.get("static", False))
+		is_static = bool(getattr(expr.ref_or_name, "attributes", {}).get("static", False))
 		args.append(attribute_info.AccessAttribute.READ if is_static else attribute_info.AccessAttribute.NONE)
 
 		return min(args)
@@ -215,7 +215,7 @@ class VarAccessVisitor(ExprVisitor):
 	@generate.register
 	def _(self, expr: behav.ProcedureCall, context: attribute_info.AccessContext):
 		args = [self.generate(arg, context) for arg in expr.args]
-		is_static = bool(expr.ref_or_name.attributes.get("static", False))
+		is_static = bool(getattr(expr.ref_or_name, "attributes", {}).get("static", False))
 		args.append(attribute_info.AccessAttribute.READ if is_static else attribute_info.AccessAttribute.NONE)
 		return min(args)
 
diff --git a/tests/test_intrinsic_staticness.py b/tests/test_intrinsic_staticness.py
new file mode 100644
index 0000000..470a3ac
--- /dev/null
+++ b/tests/test_intrinsic_staticness.py
@@ -0,0 +1,18 @@
+"""Unresolved intrinsics must be conservative, rather than treated as functions."""
+from types import SimpleNamespace
+import unittest
+from m2isar.metamodel import behav, attribute_info
+from m2isar.metamodel.utils.scalar_staticness import VarAccessVisitor
+
+
+class IntrinsicStaticness(unittest.TestCase):
+    def test_intrinsic_calls_are_dynamic(self):
+        for kind in (behav.FunctionCall,behav.ProcedureCall):
+            result=VarAccessVisitor().generate(kind('branch',[behav.Literal(1)]),attribute_info.AccessContext())
+            self.assertEqual(result,attribute_info.AccessAttribute.NONE)
+
+    def test_named_function_attributes_are_retained(self):
+        for kind in (behav.FunctionCall,behav.ProcedureCall):
+            fn=SimpleNamespace(attributes={'static':True})
+            result=VarAccessVisitor().generate(kind(fn,[]),attribute_info.AccessContext())
+            self.assertEqual(result,attribute_info.AccessAttribute.READ)
-- 
2.34.1


