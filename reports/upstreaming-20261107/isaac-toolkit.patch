diff --git a/isaac_toolkit/utils/llvm_bb_addr_map.py b/isaac_toolkit/utils/llvm_bb_addr_map.py
new file mode 100644
index 0000000..df269cb
--- /dev/null
+++ b/isaac_toolkit/utils/llvm_bb_addr_map.py
@@ -0,0 +1,107 @@
+"""Bounded decoder for linked LLVM BB address maps (LLVM 19–22).
+
+Layout follows llvm/lib/Object/ELF.cpp, decodeBBAddrMap, versions 2–5.
+Addresses require relocations to have been applied by the linker.
+"""
+import io
+
+
+def decode_bb_addr_map(data: bytes, address_size: int):
+    """Return function records with ranges and fixed block IDs.
+
+    Optional callsite, hash and PGO payloads are consumed to keep subsequent
+    records aligned. Maps without BB entries cannot support profile matching.
+    """
+    if address_size not in (4, 8):
+        raise ValueError("BB map address size must be 4 or 8")
+    reader = io.BytesIO(data)
+
+    def fixed(size):
+        raw = reader.read(size)
+        if len(raw) != size:
+            raise ValueError(f"Truncated BB address map at offset {reader.tell()}")
+        return int.from_bytes(raw, "little")
+
+    def uleb(bits=32):
+        value = 0
+        for shift in range(0, bits, 7):
+            byte = fixed(1)
+            value |= (byte & 0x7f) << shift
+            if value >= 1 << bits:
+                raise ValueError("Oversized ULEB128 in BB address map")
+            if not byte & 0x80:
+                return value
+        raise ValueError("Oversized ULEB128 in BB address map")
+
+    def count(bits=32):
+        value = uleb(bits)
+        # Every element below consumes at least one byte. Bound loops before
+        # allocating or iterating over a corrupted untrusted count.
+        if value > len(data) - reader.tell():
+            raise ValueError("BB map count exceeds remaining payload")
+        return value
+
+    records = []
+    while reader.tell() < len(data):
+        version = fixed(1)
+        if version not in (2, 3, 4, 5):
+            raise NotImplementedError(f"LLVM_BB_ADDR_MAP version {version}")
+        features = fixed(2 if version >= 5 else 1)
+        if features & ~0xff:
+            raise NotImplementedError(f"Unsupported BB address map features: {features:#x}")
+        if ((features & 0x20 and version < 3) or
+                (features & 0x40 and version < 4) or
+                (features & 0x80 and version < 5)):
+            raise ValueError("BB map feature is incompatible with its version")
+        if features & 0x10:
+            raise ValueError("BB map omits the entries required for profile matching")
+        multi = bool(features & 8)
+        num_ranges = count() if multi else 1
+        if num_ranges == 0:
+            raise ValueError("BB map has no address ranges")
+        ranges = []
+        ids = set()
+        for _ in range(num_ranges):
+            base = fixed(address_size)
+            num_blocks = count()
+            blocks = []
+            previous_end = 0
+            for _ in range(num_blocks):
+                bb_id = uleb()
+                if bb_id in ids:
+                    raise ValueError(f"Duplicate BB ID {bb_id} in BB map function")
+                ids.add(bb_id)
+                offset = previous_end + uleb()
+                callsite_size = 0
+                if features & 0x20:
+                    for _ in range(count()):
+                        callsite_size += uleb()
+                size = callsite_size + uleb()
+                metadata = uleb()
+                if metadata & ~0x1f:
+                    raise ValueError(f"Unknown BB metadata: {metadata:#x}")
+                if features & 0x40:
+                    fixed(8)
+                previous_end = offset + size
+                if previous_end >= 1 << 32 or base + previous_end > 1 << (address_size * 8):
+                    raise ValueError("BB map address/offset overflow")
+                blocks.append((bb_id, base + offset, size))
+            ranges.append((base, blocks))
+        if features & 1:
+            uleb(64)  # Function entry count.
+        # Match LLVM's hasPGOAnalysisBBData(): PostLinkCfg alone does not
+        # introduce a per-block payload, but adds fields to BBFreq/BrProb.
+        if features & 6:
+            for _ in range(len(ids)):
+                if features & 2:
+                    uleb(64)
+                if features & 0x80:
+                    uleb()
+                if features & 4:
+                    for _ in range(count(64)):
+                        uleb()  # Successor BB ID.
+                        uleb()  # Raw branch probability.
+                        if features & 0x80:
+                            uleb()
+        records.append({"version": version, "features": features, "ranges": ranges})
+    return records
diff --git a/tests/unit-tests/utils/test_llvm_bb_addr_map.py b/tests/unit-tests/utils/test_llvm_bb_addr_map.py
new file mode 100644
index 0000000..0b05b75
--- /dev/null
+++ b/tests/unit-tests/utils/test_llvm_bb_addr_map.py
@@ -0,0 +1,88 @@
+"""LLVM 19–22 BB map wire formats and strict malformed-input rejection."""
+import pytest
+
+from isaac_toolkit.utils.llvm_bb_addr_map import decode_bb_addr_map
+
+
+def uleb(value):
+    out = bytearray()
+    while value >= 128:
+        out.append((value & 127) | 128)
+        value >>= 7
+    out.append(value)
+    return bytes(out)
+
+
+def record(version, features=0, address_size=4):
+    header = bytes([version]) + features.to_bytes(2 if version >= 5 else 1, 'little')
+    if features & 8:
+        header += uleb(2)
+    payload = b''
+    for base, bb_id in ([(0x1000, 7), (0x2000, 9)] if features & 8 else [(0x1000, 7)]):
+        payload += base.to_bytes(address_size, 'little') + uleb(1)
+        payload += uleb(bb_id) + uleb(4)
+        if features & 32:
+            payload += uleb(2) + uleb(2) + uleb(2)
+        payload += uleb(4) + uleb(1)
+        if features & 64:
+            payload += (0x1234567890abcdef).to_bytes(8, 'little')
+    if features & 1:
+        payload += uleb(1 << 40)
+    for _ in range(2 if features & 8 else 1):
+        if features & 2:
+            payload += uleb(1 << 40)
+        if features & 6 and features & 128:
+            payload += uleb(44)
+        if features & 4:
+            payload += uleb(1) + uleb(7) + uleb(0x80000000)
+            if features & 128:
+                payload += uleb(33)
+    return header + payload
+
+
+@pytest.mark.parametrize('version,features', [(2, 0), (2, 7), (2, 15), (3, 32), (4, 64),
+                                             (4, 111), (5, 0), (5, 239), (5, 128)])
+@pytest.mark.parametrize('address_size', [4, 8])
+def test_formats_and_following_record_alignment(version, features, address_size):
+    raw = record(version, features, address_size)
+    decoded = decode_bb_addr_map(raw + record(2, address_size=address_size), address_size)
+    assert len(decoded) == 2
+    assert decoded[0]['version'] == version
+    size = 8 if features & 32 else 4
+    assert decoded[0]['ranges'][0] == (0x1000, [(7, 0x1004, size)])
+    if features & 8:
+        assert decoded[0]['ranges'][1] == (0x2000, [(9, 0x2004, size)])
+    assert decoded[1]['ranges'] == [(0x1000, [(7, 0x1004, 4)])]
+
+
+@pytest.mark.parametrize('version,features', [(2, 0), (3, 32), (4, 111), (5, 239)])
+def test_every_truncation_fails(version, features):
+    data = record(version, features)
+    for end in range(1, len(data)):
+        with pytest.raises(ValueError):
+            decode_bb_addr_map(data[:end], 4)
+
+
+@pytest.mark.parametrize('raw', [b'\x01', b'\x06', b'\x05\x00\x01'])
+def test_unknown_format_or_feature_fails(raw):
+    with pytest.raises(NotImplementedError):
+        decode_bb_addr_map(raw, 4)
+
+
+@pytest.mark.parametrize('version,features', [(2, 32), (3, 64), (4, 128), (5, 16)])
+def test_incompatible_features_fail(version, features):
+    with pytest.raises(ValueError):
+        decode_bb_addr_map(record(version, features), 4)
+
+
+def test_duplicates_and_overflow_fail():
+    header = b'\x02\x00' + (0x1000).to_bytes(4, 'little') + b'\x02'
+    with pytest.raises(ValueError, match='Duplicate BB ID'):
+        decode_bb_addr_map(header + b'\x07\x00\x04\x00' * 2, 4)
+    with pytest.raises(ValueError, match='Oversized ULEB128'):
+        decode_bb_addr_map(header + b'\xff' * 5, 4)
+
+
+def test_empty_multi_range_fails():
+    with pytest.raises(ValueError, match='no address ranges'):
+        decode_bb_addr_map(b'\x02\x08\x00', 4)
