+define i32 @implMEM_ADDR_LB(ptr noalias writeonly captures(none) initializes((0, 4)) %rd, i32 %rs1, i32 %rs2) local_unnamed_addr #0 {
+  ; RV32-MIR-LABEL: name: implMEM_ADDR_LB
+  ; RV32-MIR: MEM_ADDR_LB
+  ; RV32-MIR: PseudoRET
+  ; RV32-ASM-LABEL: implMEM_ADDR_LB:
+  ; RV32-ASM: mem_addr_lb
+  ; RV32-ASM: ret
+  %1 = add i32 %rs2, %rs1
+  %2 = inttoptr i32 %1 to ptr
+  %.v3 = load i8, ptr %2, align 1
+  %3 = sext i8 %.v3 to i32
+  ret i32 %3
+}
