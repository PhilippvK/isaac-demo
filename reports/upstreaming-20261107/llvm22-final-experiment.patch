diff --git a/cmake/Modules/Findmgclient.cmake b/cmake/Modules/Findmgclient.cmake
new file mode 100644
index 00000000..b4175a5c
--- /dev/null
+++ b/cmake/Modules/Findmgclient.cmake
@@ -0,0 +1,49 @@
+# Findmgclient.cmake - Locate mgclient library and headers
+# Usage: find_package(mgclient REQUIRED)
+
+if(MGCLIENT_ROOT)
+    set(_mgclient_include "${MGCLIENT_ROOT}/include")
+    set(_mgclient_lib_dir "${MGCLIENT_ROOT}/lib")
+    set(MGCLIENT_ROOT "${MGCLIENT_ROOT}" CACHE PATH "mgclient install root" FORCE)
+else()
+    # Fall back to standard system paths
+    find_path(_mgclient_include_dir NAMES mgclient.h
+              PATHS /usr/include /usr/local/include
+              NO_DEFAULT_PATH)
+    find_library(_mgclient_lib NAMES mgclient
+                 PATHS /usr/lib /usr/local/lib
+                 NO_DEFAULT_PATH)
+    set(_mgclient_include "${_mgclient_include_dir}")
+    set(_mgclient_lib_dir "")
+endif()
+
+# Pick library: prefer shared if it exists
+if(MGCLIENT_ROOT)
+    if(EXISTS "${_mgclient_lib_dir}/libmgclient.so")
+        set(_mgclient_lib "${_mgclient_lib_dir}/libmgclient.so")
+    elseif(EXISTS "${_mgclient_lib_dir}/libmgclient.a")
+        set(_mgclient_lib "${_mgclient_lib_dir}/libmgclient.a")
+    else()
+        message(FATAL_ERROR "mgclient library not found in ${_mgclient_lib_dir}")
+    endif()
+endif()
+
+# Check include directory
+if(NOT EXISTS "${_mgclient_include}/mgclient.h")
+    message(FATAL_ERROR "mgclient.h not found in ${_mgclient_include}")
+endif()
+
+message(STATUS "mgclient include: ${_mgclient_include}")
+message(STATUS "mgclient library: ${_mgclient_lib}")
+
+# Create imported target
+add_library(mgclient SHARED IMPORTED)
+set_target_properties(mgclient PROPERTIES
+    IMPORTED_LOCATION "${_mgclient_lib}"
+    INTERFACE_INCLUDE_DIRECTORIES "${_mgclient_include}"
+)
+
+# Variables for compatibility
+set(MGCLIENT_INCLUDE_DIRS "${_mgclient_include}")
+set(MGCLIENT_LIBRARIES mgclient)
+set(MGCLIENT_FOUND TRUE)
diff --git a/llvm/docs/BBIDTracing.rst b/llvm/docs/BBIDTracing.rst
new file mode 100644
index 00000000..1ea5b3da
--- /dev/null
+++ b/llvm/docs/BBIDTracing.rst
@@ -0,0 +1,64 @@
+Tracing basic block identities in the ISAAC LLVM fork
+===================================================
+
+Machine basic blocks have two different identifiers:
+
+* ``MachineBasicBlock::getNumber()`` is the mutable MIR number printed as
+  ``%bb.N``. Renumbering and layout changes can change this number.
+* ``getBBID()`` is an optional ``UniqueBBID`` containing a fixed ``BaseID``
+  and a ``CloneID``. Newly created blocks normally receive a new base ID.
+  Deleting a block leaves a gap; renumbering does not change its fixed ID.
+
+The CDFG exporter currently stores the MIR spelling in ``BB.name`` and
+``INSTR.basic_block``, and the fixed base ID in ``bb_id``. These numbers need
+not agree, even immediately after instruction selection. The version 2
+``.llvm_bb_addr_map`` ELF section records fixed base IDs of surviving blocks,
+in final layout order. It is separate from DWARF source debugging information.
+
+Usage
+-----
+
+Use the compiler from the rebuilt, assertions-enabled LLVM build and enable
+the dedicated debug category. A previously installed copy does not contain
+the new instrumentation. From the ISAAC demo workspace:
+
+.. code-block:: sh
+
+  llvm-project/build/bin/clang --target=riscv32 -march=rv32im -mabi=ilp32 -O2 -g \
+    -fbasic-block-sections=labels -fglobal-isel \
+    -mllvm -global-isel-abort=0 -mllvm -debug-only=bbid-trace \
+    -mllvm -print-after-all -c example.c -o example.o 2> example.bbid.log
+
+``BBIDTRACE`` records creation, deletion, detachment, splitting, block movement,
+GlobalISel fallback resets, renumbering snapshots, CDFG-stage snapshots, and
+final address-map emission.
+Records identify the function, current MIR number, fixed base ID and clone ID.
+An unavailable fixed ID is printed as ``none``. Creation happens before
+insertion, so its MIR number can be ``-1``. ``clear`` and subsequent ``delete``
+records include function teardown and should not be mistaken for optimization
+deleting emitted blocks.
+Instruction transfers between blocks are visible in the accompanying machine
+IR dumps; block identity does not imply an unchanged instruction sequence.
+
+CDFG snapshots are printed even when database export is disabled. They do not
+require a live Memgraph. ``requested`` and ``selected`` describe the exporter
+enable and stage-mask settings; snapshots alone do not prove that a push took
+place. Use one log per translation unit to distinguish equal function names.
+
+Stage mask values are not chronological. In the optimized pipeline, stages
+128 (after machine sinking) and 256 (before PHI elimination) precede stage
+64 (after register allocation). Stages 1, 2, 4, 8, 16 and 32 correspond to
+IR translation, legalization, register-bank selection, instruction selection,
+fallback selection and pseudo expansion, respectively. SelectionDAG-only
+compilation skips the GlobalISel-specific stages. Optimization level and target
+can omit some stage visits.
+
+Compare with ``llvm-readobj --bb-addr-map example.elf`` after linking. Object
+files still have relocations, so address-to-function resolution can differ
+from the linked executable. IDs are scoped to a function and compilation;
+different optimization flags, instruction selectors or source revisions need
+not assign the same IDs. For matching, preserve translation-unit/function
+context, CDFG stage and fixed ID, keeping MIR labels separately. Even a fixed
+ID match does not account for subsequent instruction movement, duplication,
+splits, merges or newly created blocks. Base IDs alone also do not distinguish
+nonzero clone IDs in workflows that use block path cloning.
