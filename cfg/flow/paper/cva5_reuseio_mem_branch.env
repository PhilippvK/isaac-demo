# Experimental memory/branch discovery and compiler patterns.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$SCRIPT_DIR/cva5_reuseio.env"
export ISAAC_TOOLKIT_CONFIG_YAML=$TOP_DIR/cfg/isaac_toolkit/cva5_reuseio_mem_branch.yml
export ISAAC_QUERY_CONFIG_YAML=$TOP_DIR/cfg/isaac/query/paper/cva5_reuseio_mem_branch.yml
export ISAAC_ENCODING_INTERFACE=scaiev2
export FUSED_MEMORY=1
export FUSED_BRANCHES=1
