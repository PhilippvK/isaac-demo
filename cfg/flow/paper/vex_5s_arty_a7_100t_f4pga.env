# Independent F4PGA/SymbiFlow XC7 synthesis, VPR P&R and bitstream generation.
source "$(dirname "${BASH_SOURCE[0]}")/vex_5s_arty_a7_100t.env"
export ASIP_SYN_ENABLE=0
export FPGA_SYN_TOOL=f4pga
export FPGA_SYN_F4PGA_CORE_NAME=VEX_5S
export FPGA_SYN_F4PGA_PART=xc7a100tcsg324-1
export FPGA_SYN_F4PGA_CLOCK_NS=50
# Generate RTL only in Nailgun; independent targets run in syn_0.
export HLS_NAILGUN_OL2_ENABLE=n
