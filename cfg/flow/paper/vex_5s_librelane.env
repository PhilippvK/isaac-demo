# Independent ASIP synthesis target; Nailgun only generates RTL.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
source "$SCRIPT_DIR/vex_5s.env"
export HLS_NAILGUN_OL2_ENABLE=n
export ASIP_SYN_TOOL=librelane
export ASIP_SYN_OL2_PDK=sky130A
export ASIP_SYN_OL2_SCL=sky130_fd_sc_hd
export ASIP_SYN_OL2_CORE_NAME=VEX_5S
export ASIP_SYN_OL2_CLOCK_NS=10
