# CFU-Playground-compatible stateless operations, evaluated initially in ETISS.
CFU_DEMO_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
source "$CFU_DEMO_ROOT/cfg/flow/paper/iss_only_reuseio_rv32.env"

export ARCH=rv32im_zicsr_zifencei
export ABI=ilp32
export XLEN=32
export FPU=none
export GNU_URL="https://github.com/PhilippvK/riscv-tools/releases/download/gnu_2025.08.08_min/riscv32-unknown-elf-ubuntu-${UBUNTU_VERSION:-22.04}-rv32im_zicsr_zifencei_ilp32.tar.xz"
export ISAAC_GNU_INSTALL_DIR="${ISAAC_GNU_INSTALL_DIR:-$CFU_DEMO_ROOT/install/gnu_cfu}"
# Runtime libraries can contain compressed instructions even when application
# code is compiled without C. Generated custom instructions are always 32-bit.
export ISAAC_BASE_EXTENSIONS="i,m,c,zicsr,zifencei"
export ISAAC_ENCODING_POLICY=cfu
export ISAAC_TOOLKIT_CONFIG_YAML="$CFU_DEMO_ROOT/cfg/isaac_toolkit/iss_only_rv32.yml"
export ISAAC_QUERY_CONFIG_YAML="$CFU_DEMO_ROOT/cfg/isaac/query/cfu.yml"
unset CFU_DEMO_ROOT
