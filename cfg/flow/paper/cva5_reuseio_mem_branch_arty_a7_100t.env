# Experimental effects plus the Arty A7-100 board shell.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$SCRIPT_DIR/cva5_reuseio_mem_branch.env"
export FPGA_SYN_BOARD=arty_a7_100
export FPGA_SYN_VIVADO_PART=xc7a100tcsg324-1
export FPGA_SYN_VIVADO_CLK_PERIOD=50
export FPGA_SYN_VIVADO_CLOCK_NS=$FPGA_SYN_VIVADO_CLK_PERIOD
