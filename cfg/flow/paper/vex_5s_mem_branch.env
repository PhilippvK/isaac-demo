# Experimental scalar effects on VEX_5S, with distinct input/output registers.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$SCRIPT_DIR/vex_5s.env"
export ISAAC_TOOLKIT_CONFIG_YAML=$TOP_DIR/cfg/isaac_toolkit/vex_5s_mem_branch.yml
export ISAAC_QUERY_CONFIG_YAML=$TOP_DIR/cfg/isaac/query/paper/vex_5s_mem_branch.yml
export ISAAC_BASE_EXTENSIONS="i,m,zicsr,zifencei"
export ISAAC_ENCODING_INTERFACE=scaiev2
export ISAAC_HLS_CORE_DISCARDS_X0_WRITES=1
export FUSED_MEMORY=1
export FUSED_BRANCHES=1
export HLS_IMAGE=${VEX5_HLS_IMAGE:-isaac-quickstart-hls-vex5:local}
export USE_HLS_DOCKER=1
export HLS_NAILGUN_OL2_ENABLE=n
export HLS_NAILGUN_ILP_SOLVER=CBC
export ASIP_SYN_ENABLE=0
export FPGA_SYN_ENABLE=0
