+      } else {
+        op_type = OPERATOR;
+      }
+      std::string op_type_str = op_type_to_str(op_type);
+#if DEBUG
+      llvm::outs() << "op_type_str=" << op_type_str << "\n";
+#endif
+      create_inst(session, inst_str, name, op_type_str, "", f_name, bb_name, bb_id, module_name, CurrentStage);
